# The part of micropython-lib's umqtt.simple the Pico adapters use: a mip dependency, so the
# board stubs have none.
from collections.abc import Callable

class MQTTException(Exception): ...  # noqa: N818 -- umqtt's own name

class MQTTClient:
    def __init__(
        self,
        client_id: str,
        server: str,
        port: int = 0,
        user: str | None = None,
        password: str | None = None,
        keepalive: int = 0,
        ssl: object | None = None,
    ) -> None: ...
    def set_callback(self, f: Callable[[bytes, bytes], None]) -> None: ...
    def connect(self, clean_session: bool = True, timeout: float | None = None) -> int: ...
    def disconnect(self) -> None: ...
    def ping(self) -> None: ...
    def publish(self, topic: str, msg: bytes, retain: bool = False, qos: int = 0) -> None: ...
    def subscribe(self, topic: str, qos: int = 0) -> None: ...
    def check_msg(self) -> int | None: ...
