# The part of MicroPython 1.29.0's tls the Pico adapters use, typed: the board stub leaves it
# untyped and omits verify_mode.
from socket import socket
from typing import Final

PROTOCOL_TLS_CLIENT: Final[int]
CERT_NONE: Final[int]
CERT_REQUIRED: Final[int]

class SSLSocket:
    def read(self, size: int, /) -> bytes: ...
    def readline(self) -> bytes: ...
    def write(self, data: bytes, /) -> int | None: ...
    def close(self) -> None: ...

class SSLContext:
    verify_mode: int
    def __init__(self, protocol: int, /) -> None: ...
    def load_verify_locations(self, cadata: str | bytes, /) -> None: ...
    def load_cert_chain(self, cert: str | bytes, key: str | bytes, /) -> None: ...
    def wrap_socket(self, sock: socket, *, server_hostname: str | None = None) -> SSLSocket: ...
